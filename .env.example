# Environment Variables

# ============================================
# Node Environment
# ============================================
NODE_ENV=development
PORT=3001

# ============================================
# SQS Configuration
# ============================================
# Modo LOCAL: usa fila em memória (sem AWS)
# Modo AWS: usa AWS SDK v3 com credenciais reais
USE_OFFLINE=true

# URL da fila SQS (apenas necessária se USE_OFFLINE=false)
# Exemplo: https://sqs.us-east-1.amazonaws.com/123456789012/domino-queue
SQS_QUEUE_URL=

# Credenciais AWS (apenas se USE_OFFLINE=false)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Obrigatório para credenciais temporárias: AWS Academy, IAM Role com STS, MFA
# Deixe vazio se estiver usando um usuário IAM permanente
AWS_SESSION_TOKEN=

# ============================================
# Frontend Configuration
# ============================================
VITE_API_URL=http://localhost:3001
VITE_DEV_SERVER=true

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
