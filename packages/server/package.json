{
  "name": "domino-server",
  "version": "1.0.0",
  "description": "Backend do Jogo de Dominó com Socket.IO",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.410.0",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "socket.io": "4.7.2",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.10.6",
    "@types/uuid": "^10.0.0",
    "tsx": "4.7.0",
    "typescript": "5.3.3"
  }
}
